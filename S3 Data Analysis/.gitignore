# Per-frame AU extraction outputs (production + reruns).
# Large generated artifacts derived from the mp4 corpus, regenerable from
# pyfaceau. Keep out of the repo so a stray `git add .` can't pull them in.
recoded_per_frame/
recoded_rerun_v1315/
recoded_rerun_dual_v1316/
recoded_combined_results.csv
recoded_rerun_dual_v1316_combined_results.csv
hybrid_macS1_winS2_combined_results.csv

# Pilot/ research directory: scripts, PDFs, CSVs, and data dirs are all
# pre-publication research artifacts. Kept local until paper is published.
Pilot/

# Synkinesis investigation working dir (research artifacts, not source)
synkinesis_investigation/

# Cohort data dump (raw video metadata, not source)
RECODED_DATASET.md

# S2.5 Frame Curator outputs (curation provenance, pre-publication)
s2_5_curation.json
s2_5_curated_frames.csv
recoded_window_combined_results.csv
pilot15_window_frame_indices.csv
pilot15_inset_aus.csv

# Pilot-15 analysis OUTPUTS (audit cards, LCA/discriminator tables, render PDFs).
# All patient-derived (contain patient IDs + AU/clinical data) -> pre-publication,
# kept local. Broad globs so a stray `git add .` can never stage them. Scripts
# (*.py) and method docs (*.md) are NOT matched and remain trackable.
Pilot_15_*.pdf
pilot15_*.csv
pilot15_*.txt
pilot15_*.pdf
FPRS_FP_Key*.csv

# Deployed-params local backups (timestamped/.pre_*/.prebak). The live
# s25_auto_params.json itself stays tracked; only its backups are ignored.
s25_auto_params.json.*
